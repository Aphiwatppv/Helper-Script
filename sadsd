    # 2) Sudo as another user (e.g., ebsdba) using shell find (works for protected paths)
    auth = SSHAuth(
        hostname="your.server.com",
        username="your_normal_user",
        password="your_password",          # needed if sudo prompts
        sudo_user="ebsdba",                # run commands as this user
        sudo_require_tty=False             # set True if /etc/sudoers requires tty
    )

    print("\n-- list via sudo (non-recursive) --")
    rows = list_remote_via_sudo(auth, "/home/ebsdba", recursive=False, include_dirs=True)
    for r in rows:
        mtime = r['mtime'].isoformat(sep=' ', timespec='seconds') if r['mtime'] else "-"
        kind = "[DIR]" if r["is_dir"] else "     "
        print(f"{kind} {mtime} {r['size']:>10} {r['path']}")

    print("\n-- via sudo + pattern='*.log' (recursive) --")
    logs = list_remote_via_sudo(auth, "/var/log", recursive=True, include_dirs=False, pattern="*.log")
    for r in logs[:20]:
        mtime = r['mtime'].isoformat(sep=' ', timespec='seconds') if r['mtime'] else "-"
        print(f"{mtime} {r['size']:>10} {r['path']}")
